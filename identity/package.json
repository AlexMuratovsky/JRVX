{
  "name": "jrvx-id",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.19.0"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "check": "node scripts/build.mjs && node --check .build/app/worker.js && node --check src/client/id-next.js",
    "test": "node --test test/*.test.mjs",
    "build": "wrangler deploy --dry-run --outdir .build/dry-run",
    "types": "wrangler types",
    "dev": "wrangler dev --local",
    "deploy:staging": "node scripts/deploy-staging.mjs",
    "rollback:staging": "node scripts/rollback-staging.mjs",
    "smoke:staging": "node scripts/smoke.mjs",
    "extract:client": "node scripts/extract-client.mjs",
    "migration:inspect": "node scripts/migration.mjs inspect",
    "migration:candidate": "node scripts/migration.mjs candidate"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261018.1",
    "esbuild": "0.28.2",
    "miniflare": "5.20261012.1-beta",
    "wrangler": "4.151.1"
  }
}
