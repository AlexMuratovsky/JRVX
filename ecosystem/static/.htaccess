DirectoryIndex index.html
Options -Indexes
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{HTTP_HOST} ^www\.jrvx\.ru$ [NC]
RewriteRule ^ https://jrvx.ru%{REQUEST_URI} [R=301,L,NE]
RewriteCond %{QUERY_STRING} (^|&)view=(today|schedule|tasks)(&|$) [NC]
RewriteRule ^$ https://planhelper-alemura.nezhnnno.chatgpt.site/workspace [R=302,L,QSD]
RewriteRule ^(workspace|activity|ai-settings|chat|confirm|games|import|integration|notes|plans|reminders|search|auth|api|mcp|health)(/.*)?$ https://planhelper-alemura.nezhnnno.chatgpt.site/$1$2 [R=307,L,NE]
</IfModule>
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'none'"
</IfModule>
ErrorDocument 404 /404.html
