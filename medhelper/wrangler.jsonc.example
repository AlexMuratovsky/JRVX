{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jrvx-medhelper",
  "main": "./backend/worker.mjs",
  "compatibility_date": "2026-10-27",
  "workers_dev": true,
  "assets": {"directory": "./dist", "binding": "ASSETS", "run_worker_first": ["/api/*"]},
  "vars": {
    "JRVX_ID_ISSUER": "https://id.jrvx.ru",
    "JRVX_ID_AUDIENCE": "jrvx-medhelper",
    "JRVX_ID_JWKS_URL": "https://id.jrvx.ru/REPLACE_WITH_VERIFIED_JWKS_ENDPOINT",
    "QUOTA_TIMEZONE": "Europe/Moscow",
    "OPENAI_MODEL": "CHOOSE_AVAILABLE_MODEL"
  },
  "d1_databases": [{"binding": "DB", "database_name": "jrvx-medhelper", "database_id": "REPLACE_WITH_NEW_ISOLATED_D1_ID"}]
}
